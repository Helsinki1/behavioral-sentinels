  "task_assistant_messages": [
    "Lauren draws 6 large-sized picture scenes in 8 hours.\n\nHer hourly production rate is\n\n\\[\n\\frac{6\\text{ scenes}}{8\\text{ hours}}=\\frac{3}{4}\\text{ scene per hour}.\n\\]\n\n\\[\n\\boxed{\\frac{3}{4}\\text{ large-sized picture scene per hour}}\n\\]",
