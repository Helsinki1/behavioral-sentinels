  "task_assistant_messages": [
    "Tatiana has:\n\n\\[\n7+6=13\n\\]\n\nTherefore, she has \\(\\boxed{13\\text{ hours}}\\) available during the weekend.",
    "Tatiana has:\n\n\\[\n7+5=12\n\\]\n\nTherefore, she has \\(\\boxed{12\\text{ hours}}\\) available during the weekend.",
    "Tatiana has \\(12\\) total hours available, and each soccer match lasts \\(2\\) hours:\n\n\\[\n12 \\div 2 = 6\n\\]\n\nShe can fit \\(\\boxed{6\\text{ soccer matches}}\\) into her weekend.",
